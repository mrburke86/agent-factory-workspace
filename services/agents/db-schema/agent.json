{
  "id": "db-schema",
  "name": "Database Schema & Migration Agent",
  "version": "1.0.0",
  "entry": "./dist/index.js",
  "inputSchema": {
    "type": "object",
    "required": ["dataModel", "techStack", "outputDir"],
    "properties": {
      "dataModel": {
        "type": "object",
        "required": ["entities", "relationships"],
        "properties": {
          "entities": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["name", "fields"],
              "properties": {
                "name": { "type": "string" },
                "fields": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": ["name", "type"],
                    "properties": {
                      "name": { "type": "string" },
                      "type": { "type": "string" },
                      "primaryKey": { "type": "boolean" },
                      "unique": { "type": "boolean" },
                      "nullable": { "type": "boolean" },
                      "references": {
                        "type": "object",
                        "required": ["entity", "field"],
                        "properties": {
                          "entity": { "type": "string" },
                          "field": { "type": "string" }
                        },
                        "additionalProperties": false
                      }
                    },
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "relationships": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type"],
              "properties": {
                "type": {
                  "type": "string",
                  "enum": ["one-to-many", "many-to-many", "self-referential"]
                },
                "from": { "type": "string" },
                "to": { "type": "string" },
                "foreignKey": { "type": "string" },
                "entity": { "type": "string" },
                "junctionTable": { "type": "string" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      },
      "techStack": {
        "type": "object",
        "required": ["database"],
        "properties": {
          "database": {
            "type": "string",
            "enum": ["postgresql", "sqlite"]
          },
          "orm": {
            "type": "string",
            "enum": ["drizzle", "prisma"]
          }
        },
        "additionalProperties": false
      },
      "outputDir": {
        "type": "string"
      },
      "seedData": {
        "type": "object",
        "properties": {},
        "additionalProperties": true
      },
      "correlationId": {
        "type": "string"
      }
    },
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "required": ["schemaFiles", "migrationFiles", "runtimeEvents"],
    "properties": {
      "schemaFiles": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["path", "content", "language"],
          "properties": {
            "path": { "type": "string" },
            "content": { "type": "string" },
            "language": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "migrationFiles": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["path", "content", "language"],
          "properties": {
            "path": { "type": "string" },
            "content": { "type": "string" },
            "language": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "seedFile": {
        "type": "object",
        "required": ["path", "content", "language"],
        "properties": {
          "path": { "type": "string" },
          "content": { "type": "string" },
          "language": { "type": "string" }
        },
        "additionalProperties": false
      },
      "runtimeEvents": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["eventName", "eventVersion", "occurredAt", "correlationId", "payload"],
          "properties": {
            "eventName": { "type": "string" },
            "eventVersion": { "type": "string" },
            "occurredAt": { "type": "string" },
            "correlationId": { "type": "string" },
            "tenantId": { "type": "string" },
            "payload": { "type": "object", "properties": {}, "additionalProperties": true }
          },
          "additionalProperties": false
        }
      },
      "recovery": {
        "type": "object",
        "required": ["action", "rationale"],
        "properties": {
          "action": { "type": "string" },
          "rationale": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "additionalProperties": false
  },
  "capabilities": [
    "db-schema-generation",
    "migration-generation",
    "file-scope-enforcement",
    "compile-validation"
  ]
}
