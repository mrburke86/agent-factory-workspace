{
  "id": "orchestrator",
  "name": "Orchestrator",
  "version": "0.1.0",
  "entry": "./dist/index.js",
  "inputSchema": {
    "type": "object",
    "required": ["l2Config", "repoRoot"],
    "anyOf": [
      {
        "required": ["task"]
      },
      {
        "required": ["taskList"]
      }
    ],
    "properties": {
      "task": {
        "type": "object",
        "properties": {},
        "additionalProperties": true
      },
      "taskList": {
        "type": "object",
        "properties": {},
        "additionalProperties": true
      },
      "l2Config": {
        "type": "object",
        "properties": {},
        "additionalProperties": true
      },
      "repoRoot": {
        "type": "string"
      },
      "tokenBudget": {
        "type": "number"
      }
    },
    "additionalProperties": true
  },
  "outputSchema": {
    "type": "object",
    "required": ["artifactPaths", "tokenUsage", "correlationId"],
    "anyOf": [
      {
        "required": ["pipelineResult", "stageResults"]
      },
      {
        "required": ["overallResult", "taskResults"]
      }
    ],
    "properties": {
      "pipelineResult": {
        "type": "object",
        "required": ["ok", "completedStages", "retryCount"],
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "completedStages": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "failedStage": {
            "type": "string"
          },
          "retryCount": {
            "type": "number"
          }
        },
        "additionalProperties": false
      },
      "overallResult": {
        "type": "object",
        "required": ["ok", "completedTasks", "failedTasks", "skippedTasks"],
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "completedTasks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "failedTasks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "skippedTasks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      },
      "stageResults": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["stageName", "ok", "durationMs", "tokenCount", "outputPath"],
          "properties": {
            "stageName": {
              "type": "string"
            },
            "ok": {
              "type": "boolean"
            },
            "durationMs": {
              "type": "number"
            },
            "tokenCount": {
              "type": "number"
            },
            "outputPath": {
              "type": "string"
            },
            "error": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "taskResults": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["taskId", "ok", "status", "stageResults", "tokenUsage", "artifactPath"],
          "properties": {
            "taskId": {
              "type": "string"
            },
            "ok": {
              "type": "boolean"
            },
            "status": {
              "type": "string",
              "enum": ["completed", "failed", "skipped"]
            },
            "skippedReason": {
              "type": "string"
            },
            "stageResults": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["stageName", "ok", "durationMs", "tokenCount", "outputPath"],
                "properties": {
                  "stageName": {
                    "type": "string"
                  },
                  "ok": {
                    "type": "boolean"
                  },
                  "durationMs": {
                    "type": "number"
                  },
                  "tokenCount": {
                    "type": "number"
                  },
                  "outputPath": {
                    "type": "string"
                  },
                  "error": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            },
            "tokenUsage": {
              "type": "object",
              "required": ["perStage", "total"],
              "properties": {
                "perStage": {
                  "type": "object",
                  "properties": {},
                  "additionalProperties": true
                },
                "total": {
                  "type": "number"
                }
              },
              "additionalProperties": false
            },
            "artifactPath": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "artifactPaths": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "tokenUsage": {
        "type": "object",
        "required": ["perStage", "total"],
        "properties": {
          "perStage": {
            "type": "object",
            "properties": {},
            "additionalProperties": true
          },
          "total": {
            "type": "number"
          }
        },
        "additionalProperties": false
      },
      "correlationId": {
        "type": "string"
      }
    },
    "additionalProperties": false
  },
  "capabilities": ["pipeline-orchestration", "error-recovery", "artifact-logging"]
}
