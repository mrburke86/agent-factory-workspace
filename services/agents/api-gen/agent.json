{
  "id": "api-gen",
  "name": "API Route Generation Agent",
  "version": "1.0.0",
  "entry": "./dist/index.js",
  "inputSchema": {
    "type": "object",
    "required": ["routes", "techStack", "outputDir"],
    "properties": {
      "routes": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["method", "path", "purpose", "auth"],
          "properties": {
            "method": {
              "type": "string",
              "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"]
            },
            "path": { "type": "string" },
            "purpose": { "type": "string" },
            "auth": { "type": "boolean" },
            "inputSchema": {
              "type": "object",
              "properties": {},
              "additionalProperties": true
            },
            "outputSchema": {
              "type": "object",
              "properties": {},
              "additionalProperties": true
            }
          },
          "additionalProperties": false
        }
      },
      "techStack": {
        "type": "object",
        "required": ["framework"],
        "properties": {
          "framework": {
            "type": "string",
            "enum": ["nextjs-app-router", "express"]
          }
        },
        "additionalProperties": false
      },
      "schemaRefs": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {},
          "additionalProperties": true
        }
      },
      "outputDir": { "type": "string" },
      "correlationId": { "type": "string" }
    },
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "required": ["routeFiles", "runtimeEvents"],
    "properties": {
      "routeFiles": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["path", "content", "language"],
          "properties": {
            "path": { "type": "string" },
            "content": { "type": "string" },
            "language": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "middlewareFiles": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["path", "content", "language"],
          "properties": {
            "path": { "type": "string" },
            "content": { "type": "string" },
            "language": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "runtimeEvents": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["eventName", "eventVersion", "occurredAt", "correlationId", "payload"],
          "properties": {
            "eventName": { "type": "string" },
            "eventVersion": { "type": "string" },
            "occurredAt": { "type": "string" },
            "correlationId": { "type": "string" },
            "tenantId": { "type": "string" },
            "payload": { "type": "object", "properties": {}, "additionalProperties": true }
          },
          "additionalProperties": false
        }
      },
      "recovery": {
        "type": "object",
        "required": ["action", "rationale"],
        "properties": {
          "action": { "type": "string" },
          "rationale": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "additionalProperties": false
  },
  "capabilities": [
    "api-route-generation",
    "zod-validation-scaffolding",
    "auth-aware-route-scaffolding",
    "file-scope-enforcement",
    "compile-validation"
  ]
}
